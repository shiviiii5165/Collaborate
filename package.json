{
  "name": "collaborate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test:sso": "tsx --import ./tests/setup-isolated-db.mjs tests/tathastu_sso_client_hardening.test.mjs && tsx --import ./tests/setup-isolated-db.mjs tests/tathastu_production_integration.test.mjs",
    "test:authz": "tsx --import ./tests/setup-isolated-db.mjs tests/api_authorization_hardening.test.mjs && tsx --import ./tests/setup-isolated-db.mjs tests/cors_and_payment_webhook.test.mjs",
    "test:phase2": "tsx --import ./tests/setup-isolated-db.mjs tests/phase2_privacy_ownership_sync.test.mjs && tsx tests/phase2_multi_instance_pg.test.mjs",
    "test:phase3": "tsx --import ./tests/setup-isolated-db.mjs tests/phase3_intelligence_matching.test.mjs",
    "test:migration": "tsx tests/migration_readiness.test.mjs && tsx scripts/rehearse_migration.ts",
    "rehearse:migration": "tsx scripts/rehearse_migration.ts",
    "test:staging": "tsx tests/staging_isolation.test.mjs",
    "test:phase4": "tsx --import ./tests/setup-isolated-db.mjs tests/phase4_autoprovision_activity.test.mjs",
    "test:ecosystem": "tsx --import ./tests/setup-isolated-db.mjs tests/ecosystem_matching_discovery.test.mjs",
    "test": "npm run test:authz && npm run test:sso && npm run test:phase2 && npm run test:phase3 && npm run test:migration && npm run test:staging && npm run test:phase4 && npm run test:ecosystem",
    "build:web": "next build",
    "start:web": "next start",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start:api": "tsx apps/api/src/index.ts",
    "dev:api": "tsx watch apps/api/src/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@neondatabase/serverless": "^1.2.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "canvas-confetti": "^1.9.4",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "lucide-react": "^1.54.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
