# ==============================================================================
# Collaborate. by AI Tathastu — Environment Variables Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Tathastu Central Integration & Single Sign-On (SSO)
# ------------------------------------------------------------------------------
# Base URL / Identity Issuer of the central AI Tathastu platform
AIT_ISSUER=https://www.aitathastu.com

# Client identifier registered on the central AI Tathastu integration system
AIT_CLIENT_ID=collaborate

# Confidential client secret issued by AI Tathastu (keep server-side only on Render; never expose to browser)
AIT_CLIENT_SECRET=tathastu_sec_collaborate_sample_placeholder_change_in_prod

# Exact registered OAuth callback URI for Collaborate
AIT_REDIRECT_URI=https://collaborate.aitathastu.com/api/auth/tathastu/callback

# OAuth authorization endpoint on AI Tathastu
AIT_AUTHORIZE_URL=https://www.aitathastu.com/integrations/authorize

# Token exchange endpoint on AI Tathastu
AIT_TOKEN_URL=https://www.aitathastu.com/api/integrations/sso/token

# Server-to-server Profile API URL (returns ProfessionalProjectionV1)
AIT_PROFILE_URL=https://www.aitathastu.com/api/integrations/v1/profile

# Remote JWKS URL for ES256 public key verification of access tokens
AIT_JWKS_URL=https://www.aitathastu.com/api/integrations/jwks

# Webhook signing secret used by AI Tathastu to sign events (HMAC-SHA256)
AIT_WEBHOOK_SECRET=tathastu_whsec_sample_placeholder_change_in_prod

# Fallback aliases (supported for backward compatibility)
AI_TATHASTU_BASE_URL=https://www.aitathastu.com
AI_TATHASTU_CLIENT_ID=collaborate
AI_TATHASTU_CLIENT_SECRET=tathastu_sec_collaborate_sample_placeholder_change_in_prod
AI_TATHASTU_REDIRECT_URI=https://collaborate.aitathastu.com/api/auth/tathastu/callback
AI_TATHASTU_WEBHOOK_SECRET=tathastu_whsec_sample_placeholder_change_in_prod

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL - Neon / Supabase Serverless)
# ------------------------------------------------------------------------------
# Required for Cloud Deployments (Vercel, Render, AWS).
# Obtain this from Supabase / Neon console with SSL connection pooling.
DATABASE_URL=postgresql://postgres.sample:sample_password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. Authentication & Session Security (Minimum 32 characters)
# ------------------------------------------------------------------------------
# Secret key used for signing Collaborate internal session JWTs (HS256)
AUTH_SECRET=collaborate_production_secret_key_2026_at_least_32_bytes_long

# Secret key used for Fastify cookie parsing and signing
SESSION_SECRET=collaborate_production_session_signing_secret_2026

# ------------------------------------------------------------------------------
# 4. Platform Deployment Host URLs
# ------------------------------------------------------------------------------
# Public production frontend URL(s) for CORS and links (comma-separated if multiple)
NEXT_PUBLIC_APP_URL=https://collaborate.aitathastu.com,https://collaborate-umber.vercel.app

# Backend API server URL where Next.js gateway forwards all /api/* requests
COLLABORATE_BACKEND_URL=https://collaborate-1-am72.onrender.com

# ------------------------------------------------------------------------------
# 5. Local Development Overrides (Strictly ignored in Cloud runtimes)
# ------------------------------------------------------------------------------
# Allows local JSON file persistence strictly on developer machines when DATABASE_URL is not set
COLLABORATE_ALLOW_LOCAL_STORAGE=false

# Enables test switch persona buttons in AuthModal strictly for local staging QA
COLLABORATE_ENABLE_FIXTURES=false
