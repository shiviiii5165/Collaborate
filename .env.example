# ==============================================================================
# Collaborate. by AI Tathastu — Environment Variables Template
# ==============================================================================

# Database (Neon Serverless PostgreSQL)
# Required for Cloud Deployments (Vercel, Render, AWS).
# Obtain this from https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/collaborate?sslmode=require

# Authentication & Session Security (Minimum 32 characters)
AUTH_SECRET=collaborate_production_secret_key_2026_at_least_32_bytes_long
SESSION_SECRET=collaborate_production_session_signing_secret_2026

# Platform Host URLs
NEXT_PUBLIC_APP_URL=https://collaborate-umber.vercel.app
COLLABORATE_BACKEND_URL=https://collaborate-1-am72.onrender.com

# Local Development Overrides (Strictly ignored in Cloud runtimes)
COLLABORATE_ALLOW_LOCAL_STORAGE=false
COLLABORATE_ENABLE_FIXTURES=false

# External AI Tathastu Core Integration (Mock mode enabled by default)
TATHASTU_INTEGRATION_MODE=mock
TATHASTU_CORE_API_URL=https://api.aitathastu.com
